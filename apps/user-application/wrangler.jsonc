/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "user-application",
	"main": "worker/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/auth/*", "/trpc/*", "/click-socket"]
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"stage": {
			"vars": {
				"STRIPE_PRODUCT_BASIC": "price_1S6WKPP6D19kwI6Lvdj3Iqgz",
				"STRIPE_PRODUCT_PRO": "price_1S6WM3P6D19kwI6LxC9Salp9",
				"STRIPE_PRODUCT_ENTERPRISE": "price_1S6WMnP6D19kwI6LIxpbXIiu"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "a0ad8fc9-323e-468a-8f34-80629a5e3dd6",
					"experimental_remote": true
				}
			],
			"services": [
				{
					"binding": "BACKEND_SERVICE",
					"service": "data-service-stage",
					"experimental_remote": true
				}
			]
		},
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "c5b9b3bb-2b75-4744-9ae1-4af2e3e2d76f"
				}
			],
			"services": [
				{
					"binding": "BACKEND_SERVICE",
					"service": "data-service-production"
				}
			]
		}
	}
}
